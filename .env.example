# Backend: SQLite development database, relative to the backend directory.
APP_NAME=Continuous Learning ML API
DATABASE_URL=sqlite:///./app.db

# Manual/automatic training, evaluation, and promotion configuration.
AUTO_RETRAIN_ENABLED=true
RETRAIN_MIN_NEW_SAMPLES=50
MIN_TRAINING_SAMPLES=100
ML_TEST_SIZE=0.2
ML_RANDOM_STATE=42
MODEL_DIR=models
PRIMARY_PROMOTION_METRIC=f1_score
MIN_PROMOTION_IMPROVEMENT=0.01
MIN_ACCEPTABLE_F1=0.60

# Drift and verified-performance monitoring.
DRIFT_WINDOW_SIZE=200
DRIFT_MIN_SAMPLES=50
DRIFT_PSI_WARNING=0.10
DRIFT_PSI_CRITICAL=0.25
PERFORMANCE_WINDOW_SIZE=100
PERFORMANCE_MIN_FEEDBACK_SAMPLES=30
PERFORMANCE_WARNING_DROP=0.05
PERFORMANCE_CRITICAL_DROP=0.10

# Celery/Redis training infrastructure. These defaults expect Redis
# exposed locally by `docker compose up redis`.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false
TRAINING_QUEUE_NAME=training
TRAINING_TASK_MAX_RETRIES=3
TRAINING_TASK_RETRY_DELAY_SECONDS=60
TRAINING_LOCK_TIMEOUT_SECONDS=3600
TRAINING_TASK_SOFT_TIME_LIMIT_SECONDS=3300
TRAINING_TASK_TIME_LIMIT_SECONDS=3600
TRAINING_STALE_TIMEOUT_SECONDS=3600
WORKER_HEALTH_TIMEOUT_SECONDS=1.0
WORKER_HEALTH_CACHE_SECONDS=5.0
REDIS_URL=redis://localhost:6379/2

# Backend: local default. Codespaces setup replaces this automatically.
FRONTEND_ORIGIN=http://localhost:5173

# Backend: retain local development when FRONTEND_ORIGIN is a Codespaces URL.
LOCAL_FRONTEND_ORIGIN=http://localhost:5173

# Backend: permits the Vite port exposed by a GitHub Codespace.
CODESPACES_ORIGIN_REGEX=https://[a-z0-9-]+-5173\.app\.github\.dev

# Frontend: local default. Codespaces setup replaces this automatically.
VITE_API_BASE_URL=http://localhost:8000
