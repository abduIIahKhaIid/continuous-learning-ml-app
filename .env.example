# Backend: origin permitted to call FastAPI from a browser.
FRONTEND_ORIGIN=http://localhost:5173

# Backend: permits the Vite port exposed by a GitHub Codespace.
CODESPACES_ORIGIN_REGEX=https://[a-z0-9-]+-5173\.app\.github\.dev

# Frontend: public base URL used by the API client.
VITE_API_BASE_URL=http://localhost:8000
